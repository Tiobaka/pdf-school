# PDF-School Environment Configuration
# Choose your preferred LLM provider by setting its API key below:

# 1. Google Gemini (Default: gemini-2.5-flash)
# GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenAI (Default: gpt-4o-mini)
# OPENAI_API_KEY=sk-your_openai_api_key_here

# 3. Anthropic Claude (Default: claude-3-5-haiku-20241022)
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# 4. OpenRouter / Groq / DeepSeek / Local Ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# OPENROUTER_API_KEY=sk-or-...

# Optional model override
# LLM_MODEL=gemini-2.5-pro
